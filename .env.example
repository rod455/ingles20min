# =====================================================================
# Vocaboost — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure no Vercel (produção).
# =====================================================================

# URL pública do site (usada nos back_urls do Mercado Pago e em metadados).
# Em produção use o domínio do Vercel, ex.: https://vocaboost.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Mercado Pago (assinaturas / preapproval)
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Use o Access Token de TESTE para validar e o de PRODUÇÃO ao publicar.
# ---------------------------------------------------------------------
MP_ACCESS_TOKEN=

# ---------------------------------------------------------------------
# Supabase (projeto "Inglês20minutos")
# A SERVICE ROLE KEY é secreta e só roda no servidor — nunca exponha no client.
# Painel: Project Settings -> API -> service_role (secret)
# ---------------------------------------------------------------------
SUPABASE_URL=https://ytskhrskvobfwrmslnkn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# (Opcional) chave publicável, caso precise ler dados no client futuramente.
NEXT_PUBLIC_SUPABASE_URL=https://ytskhrskvobfwrmslnkn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Automação (N8N -> Evolution API)
# Webhooks do N8N que orquestram os grupos de WhatsApp.
# Enquanto não configurados, o app apenas registra o evento no log.
# ---------------------------------------------------------------------
# Disparado quando uma assinatura PAGA é confirmada (adiciona ao grupo Premium).
N8N_WEBHOOK_URL=
# Disparado quando um lead entra pelo "Comece grátis" (inicia o funil grátis).
N8N_FREE_WEBHOOK_URL=
# Segredo compartilhado enviado no header x-webhook-secret para os dois webhooks.
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Grupo GRÁTIS do WhatsApp
# Link de convite do grupo grátis. Após o cadastro, o site redireciona o
# lead para cá. Pegue em: WhatsApp -> grupo -> Convidar via link.
# Ex.: https://chat.whatsapp.com/XXXXXXXXXXXXXXX
# ---------------------------------------------------------------------
NEXT_PUBLIC_FREE_GROUP_URL=

# ---------------------------------------------------------------------
# Grupo PREMIUM (pago) do WhatsApp
# Link de convite mostrado na página /sucesso após o pagamento.
# ---------------------------------------------------------------------
NEXT_PUBLIC_PREMIUM_GROUP_URL=
