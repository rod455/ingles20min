      "parameters": {
        "jsCode": "const cfg = $('Config (webhook)').first().json;\nconst body = $('Webhook: assinatura confirmada').first().json.body || {};\nconst number = body.whatsapp || body.phone;\nif (!number) return []; // sem telefone: nada a enviar (lead veio só com e-mail)\nconst text = `🎉 Pagamento confirmado! Bem-vindo(a) ao *Vocaboost Premium*.\\n\\nEntre no grupo exclusivo e receba sua lição diária com professor: ${cfg.PREMIUM_GROUP_INVITE}`;\nreturn [{ json: { ...cfg, number, text } }];"
      },
