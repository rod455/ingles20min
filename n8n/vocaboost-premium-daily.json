      "id": "prem-getstate",
      "name": "Supabase: ler ponteiro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-540, -40]
    },
    {
      "parameters": {
        "jsCode": "// Define qual 'DiaN' enviar hoje a partir do ponteiro.\n// Convenção: next_index = quantos dias já enviados; dia de hoje = next_index + 1.\nconst cfg = $('Config').first().json;\nconst rows = $input.first().json;\nconst nextIndex = Array.isArray(rows) && rows[0] ? Number(rows[0].next_index) : 0;\nconst dayNumber = nextIndex + 1;\nconst folderName = 'Dia' + dayNumber;\nconst today = new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);\nreturn [{ json: { ...cfg, nextIndex, dayNumber, folderName, nextIndexNew: nextIndex + 1, today } }];"
      },
      "id": "prem-merge",
      "name": "Juntar config + índice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, -40]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"'\" + $json.DRIVE_FOLDER_ID + \"' in parents and name = '\" + $json.folderName + \"' and mimeType = 'application/vnd.google-apps.folder' and trashed = false\" }}",
        "returnAll": true,
        "options": {}
      },
      "id": "prem-findfolder",
      "name": "Google Drive: achar pasta do dia",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [-100, -40]
    },
    {
      "parameters": {
        "jsCode": "// Pega o id da pasta DiaN. Se ela não existir, encerra (não avança o ponteiro).\nconst ctx = $('Juntar config + índice').first().json;\nconst folders = $input.all().map(i => i.json).filter(f => f && f.id);\nif (folders.length === 0) {\n  // Sem pasta para o dia atual: espera você criá-la, sem queimar o dia.\n  return [];\n}\nreturn [{ json: { ...ctx, dayFolderId: folders[0].id } }];"
      },
      "id": "prem-folderid",
      "name": "Pasta do dia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [120, -40]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"'\" + $json.dayFolderId + \"' in parents and trashed = false and mimeType != 'application/vnd.google-apps.folder'\" }}",
        "returnAll": true,
        "options": {}
      },
      "id": "prem-listfiles",
      "name": "Google Drive: listar arquivos do dia",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [340, -40]
    },
    {
      "parameters": {
        "jsCode": "// Ordena os arquivos por nome (numérico) e define o tipo de mídia de cada um.\nconst ctx = $('Juntar config + índice').first().json;\nconst files = $input.all().map(i => i.json).filter(f => f && f.id);\nfiles.sort((a, b) => String(a.name).localeCompare(String(b.name), 'pt', { numeric: true }));\nif (files.length === 0) return [];\nreturn files.map((f, i) => {\n  const mt = String(f.mimeType || '');\n  let mediatype = 'document';\n  if (mt.startsWith('image/')) mediatype = 'image';\n  else if (mt.startsWith('video/')) mediatype = 'video';\n  else if (mt.startsWith('audio/')) mediatype = 'audio';\n  const caption = String(f.name || '').replace(/\\.[^.]+$/, '');\n  return { json: { ...ctx, fileId: f.id, fileName: f.name, mimeType: mt, mediatype, caption, fileOrder: i } };\n});"
      },
      "id": "prem-queue",
      "name": "Preparar fila de envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, -40]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": { "__rl": true, "value": "={{ $json.fileId }}", "mode": "id" },
        "options": {}
      },
      "id": "prem-download",
      "name": "Google Drive: baixar arquivo",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
