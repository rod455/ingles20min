    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "EVOLUTION_URL", "value": "https://evo.seudominio.com", "type": "string" },
            { "id": "a2", "name": "EVOLUTION_INSTANCE", "value": "vocaboost", "type": "string" },
            { "id": "a3", "name": "EVOLUTION_APIKEY", "value": "SUA_API_KEY", "type": "string" },
            { "id": "a4", "name": "GROUP_JID_FREE", "value": "XXXXXXXXXXXX@g.us", "type": "string" },
            { "id": "a5", "name": "CHECKOUT_URL", "value": "https://SEU_SITE/checkout?plan=monthly", "type": "string" },
            { "id": "a6", "name": "SUPABASE_URL", "value": "https://ytskhrskvobfwrmslnkn.supabase.co", "type": "string" },
            { "id": "a7", "name": "SUPABASE_SERVICE_KEY", "value": "SERVICE_ROLE_KEY", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "free-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-340, -40]
    },
    {
      "parameters": {
        "jsCode": "// Decide a mensagem do dia no ciclo do grupo grátis.\n// Fuso America/Sao_Paulo (UTC-3).\nconst cfg = $('Config').first().json;\nconst now = new Date();\nconst sp = new Date(now.getTime() - 3 * 60 * 60 * 1000);\nconst day = sp.getUTCDay(); // 0=Dom ... 6=Sab\nconst today = sp.toISOString().slice(0, 10);\nconst checkout = cfg.CHECKOUT_URL;\n\nconst L1 = `📘 *Lição 1 — Saudações que abrem portas*\\n\\nHoje 3 formas de dizer \"tudo bem?\" como nativo:\\n\\n• *How's it going?*\\n• *What's up?*\\n• *How have you been?*\\n\\n👉 Responda aqui no grupo: como você está hoje, em inglês?`;\n\nconst U1 = `💬 Gostou da Lição 1?\\n\\nNo *Vocaboost* você recebe uma lição assim *todos os dias úteis*, com áudios, gramática e um professor pra tirar dúvidas.\\n\\nGaranta seu acesso 👉 ${checkout}`;\n\nconst L2 = `📗 *Lição 2 — Verbos do dia a dia*\\n\\n*Get* é o canivete suíço do inglês:\\n• *get up* = levantar\\n• *get it* = entender\\n• *get home* = chegar em casa\\n\\n👉 Monte uma frase com \"get\" e mande aqui!`;\n\nconst U2 = `🌟 Quem pratica todo dia, evolui.\\n\\n\"Em 3 semanas de Vocaboost eu já entendia séries sem legenda.\" — aluno real.\\n\\nVem pro grupo completo 👉 ${checkout}`;\n\nconst L3 = `📕 *Lição 3 — Destrave a conversação*\\n\\nConectores que deixam seu inglês fluido:\\n• *Actually...* (na verdade)\\n• *By the way...* (a propósito)\\n• *I mean...* (quer dizer)\\n\\n🎁 *Oferta de hoje:* assine o Vocaboost e receba sua próxima lição amanhã, no grupo Premium, com professor.\\n\\n👉 ${checkout}`;\n\nconst map = {\n  1: { key: 'free-lesson-1', text: L1 },\n  2: { key: 'free-upsell-1', text: U1 },\n  3: { key: 'free-lesson-2', text: L2 },\n  4: { key: 'free-upsell-2', text: U2 },\n  5: { key: 'free-lesson-3', text: L3 }\n};\n\nconst item = map[day];\nif (!item) return []; // fim de semana: não envia nada\n\nreturn [{ json: { contentKey: `${item.key}-${today}`, text: item.text, ...cfg } }];"
      },
      "id": "free-compose",
      "name": "Compose (lição/upsell do dia)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-120, -40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.EVOLUTION_URL }}/message/sendText/{{ $json.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $json.EVOLUTION_APIKEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.GROUP_JID_FREE, text: $json.text }) }}",
        "options": {}
      },
      "id": "free-send",
      "name": "Evolution: postar no grupo grátis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, -40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Compose (lição/upsell do dia)').item.json.SUPABASE_URL }}/rest/v1/broadcast_log",
