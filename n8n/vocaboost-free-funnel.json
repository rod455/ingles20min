    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config (webhook)').first().json;\nconst body = $('Webhook: novo lead grátis').first().json.body || {};\nconst name = (body.name || '').split(' ')[0] || 'tudo bem';\nconst number = body.whatsapp;\nif (!number) return [];\nconst text = `Olá, ${name}! 👋 Bem-vindo(a) ao *Vocaboost Grátis*.\\n\\nEntre no nosso grupo para receber suas 3 lições: ${cfg.FREE_GROUP_INVITE}\\n\\nNos próximos dias você recebe lições direto por aqui. Bora começar! 🚀`;\nreturn [{ json: { ...cfg, number, text } }];"
      },
