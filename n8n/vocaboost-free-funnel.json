      "id": "free-listfiles",
      "name": "Drive: listar arquivos do dia",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        560,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Decidir mensagem (dia+slot)').first().json;\nconst files = $input.all().map(i => i.json).filter(f => f && f.id);\nfiles.sort((a, b) => String(a.name).localeCompare(String(b.name), 'pt', { numeric: true }));\nif (files.length === 0) return [];\nreturn files.map((f, i) => {\n  const mt = String(f.mimeType || '');\n  let mediatype = 'document';\n  if (mt.startsWith('image/')) mediatype = 'image';\n  else if (mt.startsWith('video/')) mediatype = 'video';\n  else if (mt.startsWith('audio/')) mediatype = 'audio';\n  const caption = String(f.name || '').replace(/\\.[^.]+$/, '');\n  return { json: { ...ctx, fileId: f.id, fileName: f.name, mimeType: mt, mediatype, caption } };\n});"
      },
