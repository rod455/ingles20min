        "jsCode": "const cfg = $('Config (webhook)').first().json;\nconst body = $('Webhook: novo lead grátis').first().json.body || {};\nconst nome = (body.name || '').split(' ')[0] || 'tudo bem';\nconst number = body.whatsapp;\nif (!number) return [];\nconst rows = $input.all().map(i => i.json);\nconst row = rows.find(r => String(r.funil).trim() === 'free' && String(r.dia).trim() === 'boasvindas');\nlet text = String(row ? row.texto : '').replace(/{nome}/g, nome).replace(/{convite}/g, cfg.FREE_GROUP_INVITE || '');\nif (!text) text = `Olá, ${nome}! Bem-vindo(a) ao Vocaboost Grátis. Entre no grupo: ${cfg.FREE_GROUP_INVITE}`;\nreturn [{ json: { ...cfg, number, text } }];"
