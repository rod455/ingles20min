    {
      "parameters": {
        "jsCode": "// Le o copy da planilha (Google Sheets) e escolhe a mensagem do dia+horario.\nfunction fill(t, cfg) {\n  return String(t || '')\n    .replace(/{checkout}/g, cfg.CHECKOUT_URL || '')\n    .replace(/{from}/g, cfg.PRICE_FROM || '')\n    .replace(/{to}/g, cfg.PRICE_TO || '')\n    .replace(/{convite}/g, cfg.FREE_GROUP_INVITE || '');\n}\nconst cfg = $('Config').first().json;\nconst cyc = $('Supabase: ler ciclo').first().json;\nlet day = Array.isArray(cyc) && cyc[0] ? Number(cyc[0].next_index) : 0;\nif (!day || day < 1 || day > 6) day = 1;\nconst sp = new Date(Date.now() - 3 * 60 * 60 * 1000);\nconst h = sp.getUTCHours();\nlet slot = 'night';\nif (h < 11) slot = 'morning';\nelse if (h < 17) slot = 'noon';\nconst slotPt = slot === 'morning' ? 'manha' : (slot === 'noon' ? 'tarde' : 'noite');\nconst today = sp.toISOString().slice(0, 10);\nconst rows = $input.all().map(i => i.json);\nconst row = rows.find(r => String(r.funil).trim() === 'free' && String(r.dia).trim() === String(day) && String(r.horario).trim() === slotPt);\nlet text = fill(row ? row.texto : '', cfg);\nconst isNight = slot === 'night';\nconst newDay = day >= 6 ? 1 : day + 1;\nconst contentKey = `free-d${day}-${slot}-${today}`;\nconst needsMedia = (slot === 'morning' && day >= 1 && day <= 4);\nconst folderName = 'Dia' + day;\nreturn [{ json: { ...cfg, cycleDay: day, slot, slotPt, isNight, newDay, today, text, send: !!(text && text.trim()), contentKey, needsMedia, folderName } }];"
      },
